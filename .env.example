POSTGRES_PASSWORD=change-me
# Migrations run as the database owner...
MIGRATION_DATABASE_URL=postgres://finance:change-me@localhost:5432/finance
# ...and set this password on the restricted finance_app role (row-level security applies to it):
APP_DB_PASSWORD=change-me-too
# The app itself connects as finance_app. Never point this at the owner/superuser: that would
# bypass row-level security.
DATABASE_URL=postgres://finance_app:change-me-too@localhost:5432/finance
# 32-byte base64 master key (openssl rand -base64 32): encrypts uploaded statements and TOTP secrets.
# Losing it makes stored statements and 2FA enrollments unreadable; back it up separately from the DB.
FILE_ENCRYPTION_KEY=
# Where encrypted statement files are stored
BLOB_DIR=./data/blobs
# Session cookies are Secure (HTTPS-only) in production. Set to false only for a LAN install over plain HTTP.
COOKIE_SECURE=true
# The assistant is off unless both are set. When on, questions and the data the assistant retrieves
# (amounts, dates, merchant, member and account names) are sent to Anthropic; files and account
# numbers are not.
ANTHROPIC_API_KEY=
AI_ENABLED=false
